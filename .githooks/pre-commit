#!/usr/bin/env bash
# Pre-commit hook: gate every commit on the hermetic test suite.
#
# Install once per clone:
#   git config core.hooksPath .githooks
#
# Skip on emergency:
#   git commit --no-verify
#
# What runs:
#   1. go build ./...        — fail fast on compile errors
#   2. go vet ./...          — cheap static checks
#   3. go test -race ./...   — hermetic suite under the race detector
#                              (~3s warm; ~+1s vs no -race). The detector earns
#                              its keep: the suite drives concurrent WS/session
#                              goroutines, so a data race here is a real bug.
#                              First run after `go clean -cache` or a Go upgrade
#                              pays a one-time ~+4s to build the instrumented
#                              cache; steady-state is cheap.
#
# What does NOT run:
#   - -tags=live  (needs Ollama / LM Studio / OMLX / relay binary)
#   - -tags=llm   (needs Qwen3.6 MoE 35 loaded; ~5s+ runtime)

set -e

# Only run if any Go file is staged. Lets non-Go commits (docs, config) skip.
if ! git diff --cached --name-only | grep -qE '\.(go|mod|sum)$'; then
    exit 0
fi

cd "$(git rev-parse --show-toplevel)"

start=$(date +%s)

echo "→ go build ./..."
if ! go build ./...; then
    echo "✗ build failed; commit aborted"
    exit 1
fi

echo "→ go vet ./..."
if ! go vet ./...; then
    echo "✗ vet failed; commit aborted"
    exit 1
fi

echo "→ go test -race ./..."
if ! go test -race ./...; then
    echo "✗ tests failed; commit aborted"
    echo "  (rerun with: go test -race -v ./...)"
    exit 1
fi

elapsed=$(($(date +%s) - start))
echo "✓ pre-commit checks passed in ${elapsed}s"
